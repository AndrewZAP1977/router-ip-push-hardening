# Router IP Push Hardening v1 core configuration
# Copy to /etc/router-ip-push-hardening/config.env during deployment.

RIPH_CONFIG_VERSION=1

# Whitespace-separated Router IP Push router IDs.
ROUTER_IDS="AX3200"

# Keep the previous dynamic router address trusted for this many hours
# after a successful current-address change.
PREVIOUS_IP_GRACE_HOURS=4

# Refuse to generate/apply if a configured router has no valid current IPv4.
REQUIRE_ROUTER_IP=1

# Runtime/source paths.
ROUTER_IP_PUSH_DIR="/var/lib/router-ip-push"
RIPH_STATE_DIR="/var/lib/router-ip-push-hardening"
RIPH_CONFIG_DIR="/etc/router-ip-push-hardening"

# Generated Nginx geo allowlist. Never edit this file manually.
ALLOWLIST_OUTPUT="/etc/nginx/stream-enabled/05-router-ip-push-source-allow.conf"
