# Router IP Push Hardening v1 core configuration
# Copy to /etc/router-ip-push-hardening/config.env during deployment.

RIPH_CONFIG_VERSION=1

# Optional compatibility filter for dynamic Router IDs already materialized into
# RIPH provider state. Empty means accept every valid Router ID from enabled providers.
# Missing providers or zero dynamic routers are normal supported states.
ROUTER_IDS=""

# Keep the previous dynamic router address trusted for this many hours only after
# a successful current-address change while the router remains provided.
# Provider disappearance/revoke does not create grace for the withdrawn router.
PREVIOUS_IP_GRACE_HOURS=4

# Compatibility setting retained for existing deployments. Dynamic provider
# availability is no longer a core RIPH requirement; zero routers must not fail apply.
REQUIRE_ROUTER_IP=1

# RIPH-owned runtime/config paths.
RIPH_STATE_DIR="/var/lib/router-ip-push-hardening"
RIPH_CONFIG_DIR="/etc/router-ip-push-hardening"

# Optional Router IP Push adapter source. Core RIPH never reads this path directly.
# If the directory is absent, the adapter materializes an empty/absent provider state.
ROUTER_IP_PUSH_DIR="/var/lib/router-ip-push"

# Generated Nginx files. Never edit these files manually after deployment.
ALLOWLIST_OUTPUT="/etc/nginx/stream-enabled/05-router-ip-push-source-allow.conf"
STREAM_OUTPUT="/etc/nginx/stream-enabled/stream.conf"
BRIDGE_OUTPUT="/etc/nginx/stream-enabled/06-router-ip-push-fake-site-bridges.conf"

# Dedicated route-aware audit log.
STREAM_AUDIT_LOG="/var/log/nginx/riph-stream-sni.log"

# Compatibility with an older external stream audit logger/jail during a controlled
# migration. Keep OFF for normal/fresh deployments.
LEGACY_STREAM_AUDIT_COMPAT=0
LEGACY_STREAM_AUDIT_LOG="/var/log/nginx/stream-sni.log"
LEGACY_STREAM_AUDIT_FORMAT="sni_watch"

# Public SNI: always route to the public upstream.
PUBLIC_SNI="public.example.invalid"
PUBLIC_UPSTREAM="127.0.0.1:7443"

# Additional public L4 passthrough routes. Source trust does not affect them:
# both trusted and untrusted clients are sent to the same loopback backend.
PASSTHROUGH_ROUTE_COUNT=0
# PASSTHROUGH_SNI_1="cloud.example.invalid"
# PASSTHROUGH_UPSTREAM_1="127.0.0.1:10443"

# Private SNI routes.
# trusted source   -> XRAY_UPSTREAM_N
# untrusted source -> BRIDGE_LISTEN_N -> FAKE_SITE_UPSTREAM_N
PRIVATE_ROUTE_COUNT=2

PRIVATE_SNI_1="private-a.example.invalid"
XRAY_UPSTREAM_1="127.0.0.1:8443"
FAKE_SITE_UPSTREAM_1="127.0.0.1:9443"
BRIDGE_LISTEN_1="127.0.0.1:9543"

PRIVATE_SNI_2="private-b.example.invalid"
XRAY_UPSTREAM_2="127.0.0.1:8444"
FAKE_SITE_UPSTREAM_2="127.0.0.1:9444"
BRIDGE_LISTEN_2="127.0.0.1:9544"

# Unknown / empty / IP-SNI is rejected through this dead local upstream.
REJECT_UPSTREAM="127.0.0.1:9"

# Project-owned Fail2ban jails inspected by trusted-unban guard.
RIPH_FAIL2BAN_JAILS="riph-nginx-stream-sni-reject riph-nginx-stream-private-sni-abuse"
