# Router IP Push Hardening v1 core configuration
# Copy to /etc/router-ip-push-hardening/config.env during deployment.

RIPH_CONFIG_VERSION=1

# Whitespace-separated Router IP Push router IDs.
ROUTER_IDS="AX3200"

# Keep the previous dynamic router address trusted for this many hours
# after a successful current-address change.
PREVIOUS_IP_GRACE_HOURS=4

# Refuse to generate/apply if a configured router has no valid current IPv4.
REQUIRE_ROUTER_IP=1

# Runtime/source paths.
ROUTER_IP_PUSH_DIR="/var/lib/router-ip-push"
RIPH_STATE_DIR="/var/lib/router-ip-push-hardening"
RIPH_CONFIG_DIR="/etc/router-ip-push-hardening"

# Generated Nginx files. Never edit these files manually after deployment.
ALLOWLIST_OUTPUT="/etc/nginx/stream-enabled/05-router-ip-push-source-allow.conf"
STREAM_OUTPUT="/etc/nginx/stream-enabled/stream.conf"
BRIDGE_OUTPUT="/etc/nginx/stream-enabled/06-router-ip-push-fake-site-bridges.conf"

# Hexabyte public SNI: always route to the public/fake site.
PUBLIC_SNI="nukla.layerupzap.ru"
PUBLIC_UPSTREAM="127.0.0.1:7443"

# Private SNI routes.
# trusted source -> XRAY_UPSTREAM_N
# untrusted source -> BRIDGE_LISTEN_N -> FAKE_SITE_UPSTREAM_N
PRIVATE_ROUTE_COUNT=2

PRIVATE_SNI_1="treda.layerupzap.ru"
XRAY_UPSTREAM_1="127.0.0.1:8443"
FAKE_SITE_UPSTREAM_1="127.0.0.1:9443"
BRIDGE_LISTEN_1="127.0.0.1:9543"

PRIVATE_SNI_2="trongo.layerupzap.ru"
XRAY_UPSTREAM_2="127.0.0.1:8444"
FAKE_SITE_UPSTREAM_2="127.0.0.1:9444"
BRIDGE_LISTEN_2="127.0.0.1:9544"

# Unknown / empty / IP-SNI is rejected through this dead local upstream.
REJECT_UPSTREAM="127.0.0.1:9"

# Project-owned Fail2ban jails inspected by trusted-unban guard.
RIPH_FAIL2BAN_JAILS="nginx-stream-sni-reject nginx-stream-private-sni-abuse"
