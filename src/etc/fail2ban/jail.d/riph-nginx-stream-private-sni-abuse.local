# Managed by router-ip-push-hardening.
# Installed disabled; activate only after routing/trusted-state validation.
# Name/log are intentionally isolated from any pre-existing legacy Fail2ban state.

[riph-nginx-stream-private-sni-abuse]
enabled = false
filter = riph-nginx-stream-private-sni-abuse
logpath = /var/log/nginx/riph-stream-sni.log
backend = polling
usedns = no
maxretry = 3
findtime = 2m
bantime = 12h
ignorecommand = /usr/local/sbin/riph-fail2ban-ignore <ip>
action = riph-ufw-443[name=riph-nginx-stream-private-sni-abuse]
