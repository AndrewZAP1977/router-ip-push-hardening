# Managed by router-ip-push-hardening.
# Installed disabled; Phase 7 explicitly activates project jails after routing checks.

[nginx-stream-private-sni-abuse]
enabled = false
filter = nginx-stream-private-sni-abuse
logpath = /var/log/nginx/stream-sni.log
backend = polling
usedns = no
maxretry = 3
findtime = 2m
bantime = 12h
ignorecommand = /usr/local/sbin/riph-fail2ban-ignore <ip>
action = riph-ufw-443[name=nginx-stream-private-sni-abuse]
