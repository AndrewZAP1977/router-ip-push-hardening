#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMON_DEFAULT="/usr/local/libexec/riph-common.sh"
if [[ -f "${SCRIPT_DIR}/../libexec/riph-common.sh" ]]; then
    # shellcheck source=../libexec/riph-common.sh
    source "${SCRIPT_DIR}/../libexec/riph-common.sh"
else
    # shellcheck source=/usr/local/libexec/riph-common.sh
    source "${COMMON_DEFAULT}"
fi

RIPH_ROOT="/"
CONFIG_PATH="/etc/router-ip-push-hardening/config.env"
COMMAND="status"

HOTFIX_PATH_UNIT="router-ip-push-nginx-hotfix.path"
HOTFIX_TIMER_UNIT="router-ip-push-nginx-hotfix.timer"
HOTFIX_SERVICE_UNIT="router-ip-push-nginx-hotfix.service"
RIPH_PATH_UNIT="riph-router-ip.path"
RIPH_TIMER_UNIT="riph-reconcile.timer"

usage() {
    cat <<'USAGE'
Usage: riph-hotfix-handover [options] status|takeover

Options:
  --root DIR          Production '/' or temporary test root.
  --config PATH       RIPH config path inside root.
  -h, --help          Show this help.

Commands:
  status              Show temporary-hotfix and RIPH watch/timer states.
  takeover            Transfer allowlist ownership from the temporary Router IP
                      Push Nginx hotfix to RIPH without a two-writer window.

The takeover keeps the temporary hotfix files for rollback/forensics. It disables
its automatic triggers only while holding the same lock used by that hotfix, runs a
strict convergent RIPH reconcile, activates the RIPH path watch, runs a second
convergent reconcile to close the ownership-transition race, verifies current Router
IP presence in the active allowlist, then activates the 1-minute fallback timer.

Any failure after mutation begins disables RIPH automatic triggers first and restores
the temporary hotfix path/timer to their exact pre-handover enabled/active state.
USAGE
}

while (($#)); do
    case "$1" in
        --root)
            (($# >= 2)) || riph_die "--root requires a value"
            RIPH_ROOT="$(riph_validate_root "$2")"
            shift 2
            ;;
        --config)
            (($# >= 2)) || riph_die "--config requires a value"
            CONFIG_PATH="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        status|takeover)
            COMMAND="$1"
            shift
            ;;
        *)
            riph_die "unknown argument: $1"
            ;;
    esac
done

(($# == 0)) || riph_die "unexpected trailing arguments"

CONFIG_FILE="$(riph_root_path "${CONFIG_PATH}")"
riph_load_config "${CONFIG_FILE}"
riph_require_cmd flock
riph_require_cmd grep

SYSTEMCTL_BIN="${RIPH_SYSTEMCTL_BIN:-systemctl}"
if [[ "${SYSTEMCTL_BIN}" != */* ]]; then
    riph_require_cmd "${SYSTEMCTL_BIN}"
elif [[ ! -x "${SYSTEMCTL_BIN}" ]]; then
    riph_die "systemctl executable not found: ${SYSTEMCTL_BIN}"
fi

if [[ -n "${RIPH_RECONCILE_BIN:-}" ]]; then
    RECONCILE="${RIPH_RECONCILE_BIN}"
elif [[ -f "${SCRIPT_DIR}/riph-reconcile" ]]; then
    RECONCILE="${SCRIPT_DIR}/riph-reconcile"
else
    RECONCILE="/usr/local/sbin/riph-reconcile"
fi
[[ -x "${RECONCILE}" || -f "${RECONCILE}" ]] || riph_die "riph-reconcile not found: ${RECONCILE}"

unit_state() {
    local verb="$1" unit="$2"
    "${SYSTEMCTL_BIN}" "${verb}" "${unit}" 2>/dev/null || true
}

status_cmd() {
    local unit enabled active
    printf 'Temporary Router IP Push hotfix:\n'
    for unit in "${HOTFIX_PATH_UNIT}" "${HOTFIX_TIMER_UNIT}" "${HOTFIX_SERVICE_UNIT}"; do
        enabled="$(unit_state is-enabled "${unit}")"
        active="$(unit_state is-active "${unit}")"
        printf '  %-40s enabled=%-12s active=%s\n' "${unit}" "${enabled:-unknown}" "${active:-unknown}"
    done

    printf '\nRIPH ownership:\n'
    for unit in "${RIPH_PATH_UNIT}" "${RIPH_TIMER_UNIT}"; do
        enabled="$(unit_state is-enabled "${unit}")"
        active="$(unit_state is-active "${unit}")"
        printf '  %-40s enabled=%-12s active=%s\n' "${unit}" "${enabled:-unknown}" "${active:-unknown}"
    done
}

[[ "${COMMAND}" == takeover ]] || {
    status_cmd
    exit 0
}

HOTFIX_LOCK="${RIPH_HOTFIX_LOCK:-$(riph_root_path /run/lock/router-ip-push-nginx-hotfix.lock)}"
mkdir -p "$(dirname "${HOTFIX_LOCK}")"
exec 8>"${HOTFIX_LOCK}"
flock -w 15 8 || riph_die "timed out waiting for temporary hotfix lock"

hotfix_path_was_enabled="$(unit_state is-enabled "${HOTFIX_PATH_UNIT}")"
hotfix_path_was_active="$(unit_state is-active "${HOTFIX_PATH_UNIT}")"
hotfix_timer_was_enabled="$(unit_state is-enabled "${HOTFIX_TIMER_UNIT}")"
hotfix_timer_was_active="$(unit_state is-active "${HOTFIX_TIMER_UNIT}")"
riph_path_was_enabled="$(unit_state is-enabled "${RIPH_PATH_UNIT}")"
riph_path_was_active="$(unit_state is-active "${RIPH_PATH_UNIT}")"
riph_timer_was_enabled="$(unit_state is-enabled "${RIPH_TIMER_UNIT}")"
riph_timer_was_active="$(unit_state is-active "${RIPH_TIMER_UNIT}")"

if [[ "${hotfix_path_was_enabled}" != enabled && "${hotfix_path_was_active}" != active \
   && "${hotfix_timer_was_enabled}" != enabled && "${hotfix_timer_was_active}" != active ]]; then
    riph_die "temporary hotfix does not currently own the allowlist"
fi

if [[ "${riph_path_was_enabled}" == enabled || "${riph_path_was_active}" == active \
   || "${riph_timer_was_enabled}" == enabled || "${riph_timer_was_active}" == active ]]; then
    riph_die "RIPH path/timer are already enabled or active; refuse ambiguous two-writer takeover"
fi

restore_unit_state() {
    local unit="$1" was_enabled="$2" was_active="$3"

    if [[ "${was_enabled}" == enabled ]]; then
        "${SYSTEMCTL_BIN}" enable "${unit}" >/dev/null 2>&1 || true
    else
        "${SYSTEMCTL_BIN}" disable "${unit}" >/dev/null 2>&1 || true
    fi

    if [[ "${was_active}" == active ]]; then
        "${SYSTEMCTL_BIN}" start "${unit}" >/dev/null 2>&1 || true
    else
        "${SYSTEMCTL_BIN}" stop "${unit}" >/dev/null 2>&1 || true
    fi
}

TAKEOVER_STARTED=0
HANDOVER_COMMITTED=0
restore_ownership_on_exit() {
    local rc=$?
    trap - EXIT

    if (( TAKEOVER_STARTED == 1 && HANDOVER_COMMITTED == 0 )); then
        riph_log "handover failed; restoring pre-handover ownership"

        # Never restore the temporary writer before first removing any RIPH
        # automatic writer that may have been enabled before the failure.
        "${SYSTEMCTL_BIN}" disable --now "${RIPH_PATH_UNIT}" "${RIPH_TIMER_UNIT}" >/dev/null 2>&1 || true
        restore_unit_state "${RIPH_PATH_UNIT}" "${riph_path_was_enabled}" "${riph_path_was_active}"
        restore_unit_state "${RIPH_TIMER_UNIT}" "${riph_timer_was_enabled}" "${riph_timer_was_active}"
        restore_unit_state "${HOTFIX_PATH_UNIT}" "${hotfix_path_was_enabled}" "${hotfix_path_was_active}"
        restore_unit_state "${HOTFIX_TIMER_UNIT}" "${hotfix_timer_was_enabled}" "${hotfix_timer_was_active}"
    fi

    exit "${rc}"
}
trap restore_ownership_on_exit EXIT

TAKEOVER_STARTED=1

# Holding HOTFIX_LOCK guarantees the temporary service cannot be mutating the
# allowlist while its triggers are removed.
"${SYSTEMCTL_BIN}" disable --now "${HOTFIX_PATH_UNIT}" "${HOTFIX_TIMER_UNIT}" >/dev/null
"${SYSTEMCTL_BIN}" stop "${HOTFIX_SERVICE_UNIT}" >/dev/null 2>&1 || true

# Initial transaction while neither automatic writer is active. riph-reconcile
# itself rechecks live Router IP after each apply and immediately retries if the
# address changes during this transaction.
bash "${RECONCILE}" --root "${RIPH_ROOT}" --config "${CONFIG_PATH}" \
    --reason "temporary hotfix ownership handover"

"${SYSTEMCTL_BIN}" daemon-reload

# Activate only the path first. The independent periodic timer is intentionally
# added after the transition is verified, keeping takeover concurrency minimal.
"${SYSTEMCTL_BIN}" enable --now "${RIPH_PATH_UNIT}" >/dev/null
[[ "$(unit_state is-active "${RIPH_PATH_UNIT}")" == active ]] \
    || riph_die "${RIPH_PATH_UNIT} is not active after handover"

# Router IP Push does not share HOTFIX_LOCK, so the ISP address can change between
# the first reconcile and path activation. A second strict convergent reconcile
# closes that transition race; a real apply/nginx failure aborts immediately.
bash "${RECONCILE}" --root "${RIPH_ROOT}" --config "${CONFIG_PATH}" \
    --reason "post-handover Router IP verification"

ALLOWLIST_FILE="$(riph_root_path "${ALLOWLIST_OUTPUT}")"
[[ -f "${ALLOWLIST_FILE}" ]] || riph_die "generated allowlist missing after handover: ${ALLOWLIST_FILE}"

for router_id in "${RIPH_ROUTER_IDS[@]}"; do
    if current_ip="$(riph_current_router_ip "${router_id}")"; then
        grep -Eq "^[[:space:]]*${current_ip//./\\.}/32[[:space:]]+1;" "${ALLOWLIST_FILE}" \
            || riph_die "current ${router_id} IP ${current_ip} is not trusted after handover"
    elif [[ "${REQUIRE_ROUTER_IP:-1}" == 1 ]]; then
        riph_die "current Router IP missing after handover: ${router_id}"
    fi
done

"${SYSTEMCTL_BIN}" enable --now "${RIPH_TIMER_UNIT}" >/dev/null
[[ "$(unit_state is-active "${RIPH_TIMER_UNIT}")" == active ]] \
    || riph_die "${RIPH_TIMER_UNIT} is not active after handover"

HANDOVER_COMMITTED=1
trap - EXIT
riph_log "temporary hotfix ownership transferred to RIPH"
riph_log "temporary hotfix unit files/script were preserved but path/timer remain disabled"
status_cmd
