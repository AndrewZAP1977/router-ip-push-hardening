#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMON_DEFAULT="/usr/local/libexec/riph-common.sh"
if [[ -f "${SCRIPT_DIR}/../libexec/riph-common.sh" ]]; then
    # shellcheck source=../libexec/riph-common.sh
    source "${SCRIPT_DIR}/../libexec/riph-common.sh"
else
    # shellcheck source=/usr/local/libexec/riph-common.sh
    source "${COMMON_DEFAULT}"
fi

RIPH_ROOT="/"
CONFIG_PATH="/etc/router-ip-push-hardening/config.env"
MODE="sync"
DRY_RUN=0

usage() {
    cat <<'USAGE'
Usage: riph-legacy-trusted-shield [options] [sync|remove-all]

During coexistence with the old unmarked Hexabyte Fail2ban jail, keep a
project-owned TCP/443 ALLOW at the top of UFW for each *current* Router IP Push
address. This protects a newly assigned home IP even if that IP already has an
older ambiguous legacy DENY rule. Legacy DENY rules are never deleted here.

Modes:
  sync        Ensure exactly one shield rule per current Router IP and remove
              stale project-owned shield rules for older Router IPs.
  remove-all  Remove only exact project-owned shield rules.

Options:
  --root DIR       Test root prefix.
  --config PATH    Config path inside root.
  --dry-run        Report intended UFW mutations without applying them.
  -h, --help       Show this help.

Testing:
  RIPH_UFW_BIN may point to a stub executable.
USAGE
}

while (($#)); do
    case "$1" in
        --root)
            (($# >= 2)) || riph_die "--root requires a value"
            RIPH_ROOT="$(riph_validate_root "$2")"
            shift 2
            ;;
        --config)
            (($# >= 2)) || riph_die "--config requires a value"
            CONFIG_PATH="$2"
            shift 2
            ;;
        --dry-run)
            DRY_RUN=1
            shift
            ;;
        sync|remove-all)
            MODE="$1"
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            riph_die "unknown argument: $1"
            ;;
    esac
done

(($# == 0)) || riph_die "unexpected trailing arguments"

CONFIG_FILE="$(riph_root_path "${CONFIG_PATH}")"
riph_load_config "${CONFIG_FILE}"
riph_require_cmd flock
riph_require_cmd sort

UFW_BIN="${RIPH_UFW_BIN:-ufw}"
if [[ "${UFW_BIN}" == */* ]]; then
    [[ -x "${UFW_BIN}" ]] || riph_die "UFW executable not found: ${UFW_BIN}"
else
    riph_require_cmd "${UFW_BIN}"
fi

LOCK_FILE="${RIPH_UFW_LOCK:-$(riph_root_path /run/lock/riph-ufw.lock)}"
MARKER="riph-legacy-trusted-shield"
mkdir -p "$(dirname "${LOCK_FILE}")"
exec 9>"${LOCK_FILE}"
flock -w 15 9 || riph_die "timed out waiting for RIPH UFW lock"

# Output: rule-number<TAB>source-ip for exact project-owned shield rules only.
list_owned_shields() {
    local line number source
    LC_ALL=C "${UFW_BIN}" status numbered 2>/dev/null \
        | while IFS= read -r line; do
            [[ "${line}" == *"# ${MARKER}"* ]] || continue
            [[ "${line}" =~ ^[[:space:]]*\[[[:space:]]*([0-9]+)\][[:space:]]+443/tcp([[:space:]]+\(v6\))?[[:space:]]+ALLOW[[:space:]]+IN[[:space:]]+([^[:space:]]+) ]] || continue
            number="${BASH_REMATCH[1]}"
            source="${BASH_REMATCH[3]}"
            riph_is_ipv4 "${source}" || continue
            printf '%s\t%s\n' "${number}" "${source}"
        done
}

CURRENT_IPS=()
if [[ "${MODE}" == sync ]]; then
    for router_id in "${RIPH_ROUTER_IDS[@]}"; do
        if current_ip="$(riph_current_router_ip "${router_id}")"; then
            CURRENT_IPS+=("${current_ip}")
        elif [[ "${REQUIRE_ROUTER_IP:-1}" == 1 ]]; then
            riph_die "current Router IP missing while syncing legacy shield: ${router_id}"
        fi
    done

    # Normalize duplicates if multiple Router IDs happen to share one public IP.
    if ((${#CURRENT_IPS[@]} > 0)); then
        mapfile -t CURRENT_IPS < <(printf '%s\n' "${CURRENT_IPS[@]}" | sort -u)
    fi
fi

is_current_ip() {
    local wanted="$1" value
    for value in "${CURRENT_IPS[@]}"; do
        [[ "${value}" == "${wanted}" ]] && return 0
    done
    return 1
}

mapfile -t OWNED_BEFORE < <(list_owned_shields)
DELETE_NUMBERS=()
declare -A KEPT_IP=()

for row in "${OWNED_BEFORE[@]}"; do
    [[ -n "${row}" ]] || continue
    number="${row%%$'\t'*}"
    source="${row#*$'\t'}"

    if [[ "${MODE}" == remove-all ]]; then
        DELETE_NUMBERS+=("${number}")
        continue
    fi

    if ! is_current_ip "${source}"; then
        DELETE_NUMBERS+=("${number}")
        continue
    fi

    # Keep at most one exact shield for each current IP.
    if [[ -n "${KEPT_IP[${source}]:-}" ]]; then
        DELETE_NUMBERS+=("${number}")
    else
        KEPT_IP["${source}"]=1
    fi
done

if ((${#DELETE_NUMBERS[@]} > 0)); then
    mapfile -t DELETE_NUMBERS < <(printf '%s\n' "${DELETE_NUMBERS[@]}" | sort -nr -u)
    for number in "${DELETE_NUMBERS[@]}"; do
        if (( DRY_RUN == 1 )); then
            riph_log "dry-run: would delete project legacy shield UFW rule #${number}"
        else
            LC_ALL=C "${UFW_BIN}" --force delete "${number}"
        fi
    done
fi

[[ "${MODE}" == sync ]] || {
    riph_log "legacy trusted shield remove-all complete"
    exit 0
}

# Re-query after deletes because UFW renumbers rules. Build the exact current set
# that still exists before prepending anything missing.
declare -A PRESENT_IP=()
while IFS=$'\t' read -r _number source; do
    [[ -n "${source}" ]] || continue
    PRESENT_IP["${source}"]=1
done < <(list_owned_shields)

for current_ip in "${CURRENT_IPS[@]}"; do
    [[ -n "${PRESENT_IP[${current_ip}]:-}" ]] && continue
    if (( DRY_RUN == 1 )); then
        riph_log "dry-run: would prepend TCP/443 ALLOW shield for current Router IP ${current_ip}"
    else
        LC_ALL=C "${UFW_BIN}" prepend allow proto tcp from "${current_ip}" to any port 443 comment "${MARKER}"
    fi
done

riph_log "legacy trusted shield synchronized for ${#CURRENT_IPS[@]} current Router IP(s)"
