#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RECONCILE="${SCRIPT_DIR}/riph-reconcile"
ROOT_ARGS=()
ROUTER_ID=""

while (($#)); do
    case "$1" in
        --root|--config)
            (($# >= 2)) || { echo "ERROR: $1 requires a value" >&2; exit 1; }
            ROOT_ARGS+=("$1" "$2")
            shift 2
            ;;
        -h|--help)
            echo 'Usage: riph-router-ip-updated [--root DIR] [--config PATH] [ROUTER_ID]'
            exit 0
            ;;
        *)
            [[ -z "${ROUTER_ID}" ]] || { echo "ERROR: unexpected argument: $1" >&2; exit 1; }
            ROUTER_ID="$1"
            shift
            ;;
    esac
done

if [[ -n "${ROUTER_ID}" && ! "${ROUTER_ID}" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "ERROR: invalid router id: ${ROUTER_ID}" >&2
    exit 1
fi

reason="Router IP Push update"
if [[ -n "${ROUTER_ID}" ]]; then
    reason="Router IP Push update: ${ROUTER_ID}"
fi

exec bash "${RECONCILE}" "${ROOT_ARGS[@]}" --reason "${reason}"
