#!/usr/bin/env bash

set -Eeuo pipefail

MODE="${1:-}"
JAIL="${2:-}"
IP="${3:-}"
UFW_BIN="${RIPH_UFW_BIN:-ufw}"
LOCK_FILE="${RIPH_UFW_LOCK:-/run/lock/riph-ufw.lock}"

[[ "${MODE}" == ban || "${MODE}" == unban ]] || { echo 'invalid mode' >&2; exit 2; }
[[ "${JAIL}" =~ ^[A-Za-z0-9._-]{1,80}$ ]] || { echo 'invalid jail name' >&2; exit 2; }
[[ "${IP}" =~ ^[0-9A-Fa-f:.]{2,45}$ ]] || { echo 'invalid address syntax' >&2; exit 2; }

if ! command -v "${UFW_BIN}" >/dev/null 2>&1 && [[ ! -x "${UFW_BIN}" ]]; then
    echo "ufw executable not found: ${UFW_BIN}" >&2
    exit 1
fi
command -v flock >/dev/null 2>&1 || { echo 'flock not found' >&2; exit 1; }

mkdir -p "$(dirname "${LOCK_FILE}")"
exec 9>"${LOCK_FILE}"
flock -w 15 9 || { echo 'timed out waiting for RIPH UFW lock' >&2; exit 1; }

MARKER="riph-f2b-${JAIL}"

find_owned_rule_numbers() {
    local line
    LC_ALL=C "${UFW_BIN}" status numbered 2>/dev/null \
        | while IFS= read -r line; do
            # Source address is rendered as a whitespace-delimited token by
            # `ufw status numbered`; do not use substring matching here.
            [[ " ${line} " == *" ${IP} "* ]] || continue
            [[ "${line}" == *"# ${MARKER}"* ]] || continue
            if [[ "${line}" =~ ^[[:space:]]*\[[[:space:]]*([0-9]+)\] ]]; then
                printf '%s\n' "${BASH_REMATCH[1]}"
            fi
        done
}

mapfile -t RULE_NUMBERS < <(find_owned_rule_numbers | sort -nr -u)

if [[ "${MODE}" == ban ]]; then
    if ((${#RULE_NUMBERS[@]} > 0)); then
        exit 0
    fi
    LC_ALL=C "${UFW_BIN}" prepend deny proto tcp from "${IP}" to any port 443 comment "${MARKER}"
    exit 0
fi

# Delete descending numbers so UFW renumbering cannot invalidate the remaining
# entries. Only exact project marker + candidate IP matches are removed.
for number in "${RULE_NUMBERS[@]}"; do
    LC_ALL=C "${UFW_BIN}" --force delete "${number}"
done
